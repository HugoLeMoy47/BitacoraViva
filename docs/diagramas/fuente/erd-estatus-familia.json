  "cards": [
    {
      "dot": "cyan",
      "title": "Estatus historizado",
      "items": [
        "Cada eje (jurídico, estancia, albergue, expediente, etapa) guarda su valor vigente y el histórico.",
        "Cambiar de estatus cierra el vigente (valid_to) y abre otro con motivo obligatorio."
      ]
    },
    {
      "dot": "amber",
      "title": "Familia paralela",
      "items": [
        "family_unit agrupa casos; family_member enlaza cada caso con su familia y su papel.",
        "Un caso puede cambiar de familia sin perder historia."
      ]
    },
    {
      "dot": "emerald",
      "title": "Ficha social",
      "items": [
        "social_question es un catálogo editable; social_answer guarda cada respuesta con su vigencia.",
        "case_need registra las necesidades detectadas contra catalog_item."
      ]
    }
  ]
