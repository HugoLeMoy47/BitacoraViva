  "cards": [
    {
      "dot": "cyan",
      "title": "Aislamiento por organización",
      "items": [
        "Toda tabla de negocio lleva organization_id y RLS por fila.",
        "user_profile cuelga de auth.users (Supabase Auth)."
      ]
    },
    {
      "dot": "amber",
      "title": "Roles que se acumulan",
      "items": [
        "user_role guarda el rol y, si aplica, el área; se revoca sin borrar (revoked_at).",
        "capability_grant concede una capacidad a un rol o a un área, nunca a ambos."
      ]
    },
    {
      "dot": "emerald",
      "title": "Auditoría append-only",
      "items": [
        "audit_event no admite UPDATE ni DELETE; encadena eventos con prev_hash y event_hash.",
        "Solo director puede consultarla."
      ]
    }
  ]
