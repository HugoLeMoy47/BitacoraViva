  "cards": [
    {
      "dot": "cyan",
      "title": "Bitácora inmutable y privada",
      "items": [
        "journal_entry nace area_private; una corrección crea otra entrada (superseded_by_id).",
        "Compartir entre áreas exige motivo y deja un sharing_event que dirección reconoce."
      ]
    },
    {
      "dot": "amber",
      "title": "Consentimiento",
      "items": [
        "consent registra el tipo (cuidado general, datos sensibles, compartición interna, uso secundario) y se revoca sin borrarse.",
        "Sin consentimiento no se captura un campo sensible."
      ]
    },
    {
      "dot": "emerald",
      "title": "ARCO",
      "items": [
        "arco_request registra acceso, rectificación, cancelación u oposición, con motivo obligatorio.",
        "La cancelación se atiende por anonimización."
      ]
    }
  ]
